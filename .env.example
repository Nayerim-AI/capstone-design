TELEGRAM_TOKEN=***
# Token Bot Telegram. Wajib diisi untuk mode telegram.

DEFAULT_FREQ_MHZ=514.0
# Frekuensi default. Override dengan FREQUENCY_MHZ di measurement_config.yaml.

CALIBRATION_OFFSET_DB=0.0
# Offset kalibrasi. Default 0.0 (belum dikalibrasi).

# === GPS Configuration ===
GPS_ENABLED=true
GPS_PORT=/dev/ttyUSB0
GPS_BAUDRATE=4800

# === Config file measurement (parameter lainnya) ===
# Edit config/measurement_config.yaml untuk:
#   SDR_GAIN_DB, FREQUENCY_MHZ, CHANNEL_NAME, SAMPLE_RATE_HZ,
#   MEASUREMENT_BANDWIDTH_HZ, MEASUREMENT_MODE,
#   RX_ANTENNA_HEIGHT_M, CABLE_LOSS_DB, ANTENNA_FACTOR_DB_PER_M,
#   CALIBRATION_MODE, CALIBRATION_OFFSET_DB, CALIBRATION_SOURCE,
#   KOMDIGI_LOWER_DBUVM, KOMDIGI_UPPER_DBUVM
